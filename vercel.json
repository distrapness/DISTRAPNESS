{
    "version": 2,
    "builds": [
        {
            "src": "online-shop-backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "online-shop-frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        },
        {
            "source": "/favicon.ico",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/online-shop-backend/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/online-shop-frontend/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/online-shop-frontend/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/orders/auto-cancel",
            "schedule": "0 0 * * *"
        }
    ]
}